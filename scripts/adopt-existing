#!/usr/bin/env bash
set -euo pipefail

# Back up an explicitly reconciled real file before Stow takes ownership.
# Usage: scripts/adopt-existing [--dry-run] <layer/package> <home-relative-file>
# First put the reviewed configuration in the package. Contents must match.
dry_run=false
if [[ ${1:-} == --dry-run ]]; then dry_run=true; shift; fi
[[ $# == 2 ]] || { echo "Usage: $0 [--dry-run] <layer/package> <home-relative-file>" >&2; exit 1; }
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
[[ $1 != /* && $2 != /* && /$1/ != */../* && /$2/ != */../* ]] || exit 1
source="$ROOT/stow/$1/$2"
target="$HOME/$2"
[[ -f "$source" && -f "$target" && ! -L "$target" ]] || {
    echo "Expected a package source and an existing real target file: $target" >&2; exit 1;
}
cmp -s "$source" "$target" || {
    echo "Reconcile $target with $source before backing it up." >&2; exit 1;
}
if $dry_run; then echo "Would back up $target; Stow deployment is a separate step."; exit 0; fi
backup_root="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-migration"
mkdir -p "$backup_root"
backup="$(mktemp -d "$backup_root/adopt-XXXXXXXX")"
mkdir -p "$backup/$(dirname "$2")"
mv -- "$target" "$backup/$2"
echo "Backed up $target to $backup/$2; ready for Stow."
