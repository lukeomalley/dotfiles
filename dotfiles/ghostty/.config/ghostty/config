# Config generated by Ghostty Config

clipboard-read = allow
clipboard-write = allow
window-colorspace = display-p3

# Force the dark theme for now while the light-mode setup gets dialed in.
# To re-enable system-following light/dark, comment out the two lines below and
# uncomment the two after them. The light/dark themes are generated from the
# dark-rock-theme palette so the terminal matches Neovim. Do not set
# background/foreground/palette here: those would override the theme colors.
window-theme = dark
theme = night-rock
# window-theme = system
# theme = light:light-rock,dark:night-rock

font-size = 12
font-family = Inconsolata Nerd Font Mono
macos-titlebar-style = hidden

# Background transparency and blur
background-opacity = 0.95
background-blur = true

window-padding-x = 8
window-padding-y = 8

# Protect against malicious clipboard operations
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
clipboard-trim-trailing-spaces = true

# Hide mouse cursor while typing (cleaner experience)
mouse-hide-while-typing = true

# Faster scrolling
mouse-scroll-multiplier = 3

# Modern cursor style with blinking
cursor-style = block
cursor-style-blink = true

# Enable shell integration for better terminal features
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# Copy selected text automatically (like many modern terminals)
copy-on-select = true

# Save window state and position between sessions
window-save-state = always

# Quick file browser
keybind = global:cmd+ctrl+f=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 45%
quick-terminal-animation-duration = 0.08
quick-terminal-autohide = false
quick-terminal-space-behavior = move

keybind = shift+enter=text:\x1b\r
